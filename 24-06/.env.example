# Copy this file to .env (gitignored — never commit real secrets) and fill
# in your own values. main.py loads .env automatically via python-dotenv.

# Required for the "Fetch FRED macro features" button on the Feature
# Engineering page (/data/macro/fetch). Get a free key at:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Agent2 / GenW LLM endpoint. The backend tries this first and only falls
# back to Ollama if it is unavailable or misconfigured.
DELOITTE_AGENT_URL=https://agenticai.inuatintgenw.deloitte.com/api/v1/prediction/ec733222-324b-4361-961c-60d1ca71bf12
GENW_AGENT_URL=https://agenticai.inuatintgenw.deloitte.com/api/v1/prediction/ec733222-324b-4361-961c-60d1ca71bf12
LLM_CHECK_AGENT_URL=https://agenticai.inuatintgenw.deloitte.com/api/v1/prediction/ec733222-324b-4361-961c-60d1ca71bf12
DELOITTE_API_KEY=
DELOITTE_TIMEOUT_SECONDS=120
